SC5 == 1 ~ 0,  # public
SC5 == 5 ~ 1,  # international orgs
SC5 %in% c(3, 4) ~ 2,  # political / foreign
SC5 == 2 ~ 3,  # business elites
TRUE ~ NA_real_
)
)
