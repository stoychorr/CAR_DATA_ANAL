weight_table <- weight_table %>%
mutate(
sample_share = n_sample / sum(n_sample),
pop_share    = Freq / sum(Freq),
weight       = pop_share / sample_share
)
df_clean <- merge(
df_clean,
weight_table[, c("age_group", "sex", "weight")],
by = c("age_group", "sex"),
all.x = TRUE
)
# Check key uniqueness in weight table
any(duplicated(weight_table[, c("age_group", "sex")]))
# Check missing weights
table(is.na(df_clean$weight))
# Check weight distribution
summary(df_clean$weight)
# Check one weight per cell
aggregate(weight ~ age_group + sex, data = df_clean, function(x) length(unique(x)))
# Compare weighted sample shares to population shares
weighted_shares <- xtabs(weight ~ age_group + sex, data = df_clean)
weighted_shares <- weighted_shares / sum(weighted_shares)
pop_shares <- xtabs(Freq ~ age_group + sex, data = bg_pop_age_sex)
pop_shares <- pop_shares / sum(pop_shares)
weighted_shares
pop_shares
# Mean weight
mean(df_clean$weight, na.rm = TRUE)
set.seed(123)
df_clean[sample(nrow(df_clean), 10),
c("age_group", "sex", "weight")]
#write_sav(df_clean, "CMS_clean_weighted.sav")
design_w <- svydesign(
ids = ~1,
data = df_clean,
weights = ~weight
)
svymean(~A2, design_w, na.rm = TRUE)
svytable(~sex, design_w)
summary(svyglm(A2 ~ sex + age_group, design = design_w))
design_w <- update(
design_w,
sc5_excl = ifelse(
#0-> 1,5
# 2,3-> 0.67
#4-> 1
SC5 == 1, 0,
ifelse(SC5 %in% c(2, 3, 4, 5), 1, NA)
),
l_proc_01 = ifelse(L_PROC_A %in% 1:4, (4 - L_PROC_A) / 3, NA)
)
design_w$variables$consultation_exclusion <- rowMeans(design_w$variables[, c("l_proc_01", "sc5_excl")])
svymean(~consultation_exclusion, design_w, na.rm = TRUE)
svytable(~SC5, design_w)
svytable(~L_PROC_A, design_w)
svymean(~sc5_excl + l_proc_01, design_w, na.rm = TRUE)
design_w <- update(
design_w,
l_proc2_01 = ifelse(L_PROC_B %in% 1:4, (4 - L_PROC_B) / 3, NA),
l_proc3_01 = ifelse(L_PROC_C %in% 1:4, (4 - L_PROC_C) / 3, NA)
)
design_w$variables$ria_manipulation <-
rowMeans(design_w$variables[, c("l_proc2_01", "l_proc3_01")])
svymean(~ria_manipulation, design_w, na.rm = TRUE)
#Drop the lobism
design_w <- update(
design_w,
l_lobby_01 = ifelse(L_LOB %in% 1:4, (4 - L_LOB) / 3, NA)
)
svymean(~l_lobby_01, design = design_w, na.rm = TRUE)
design_w <- update(
design_w,
a9a_01  = ifelse(A9A  %in% 1:4, (4 - A9A)  / 3, NA),
a9b_01  = ifelse(A9B  %in% 1:4, (4 - A9B)  / 3, NA),
a9c_01  = ifelse(A9C  %in% 1:4, (4 - A9C)  / 3, NA),
a9d_01  = ifelse(A9D  %in% 1:4, (4 - A9D)  / 3, NA),
a10a_01 = ifelse(A10A %in% 1:4, (4 - A10A) / 3, NA),
a10b_01 = ifelse(A10B %in% 1:4, (4 - A10B) / 3, NA),
a10c_01 = ifelse(A10C %in% 1:4, (4 - A10C) / 3, NA),
a10d_01 = ifelse(A10D %in% 1:4, (4 - A10D) / 3, NA)
)
svymean(~A9A + a9a_01, design_w, na.rm = TRUE)
design_w$variables$transparency<- rowMeans(
design_w$variables[, c(
"a9a_01","a9b_01","a9c_01","a9d_01",
"a10a_01","a10b_01","a10c_01","a10d_01"
)])
svymean(~transparency, design_w, na.rm = TRUE)
vars_clean <- na.omit(vars)
fa <- factanal(
vars_clean,
factors = 1,
scores = "regression"
)
fa
vars_clean<-vars_clean[-3]
fa <- factanal(
vars_clean,
factors = 1,
scores = "regression"
)
fa
design_w <- update(
design_w,
e1_proc_01 = ifelse(E1_PART_B %in% 1:4, (4 - E1_PART_B)/3, NA),
sc4_01     = ifelse(SC4 %in% 1:4, (4 - SC4)/3, NA)
)
design_w$variables$procurement_concentration <- rowMeans(
design_w$variables[, c("e1_proc_01", "sc4_01")])
svymean(~procurement_concentration, design=design_w, na.rm=TRUE)
design_w <- update(
design_w,
e2_audit_01 = ifelse(E1_PART_A %in% 1:4, (4 - E1_PART_A) / 3, NA),
e2_bias_01  = ifelse(E1_PART_C %in% 1:4, (4 - E1_PART_C) / 3, NA),
a12a_01 = ifelse(A12A %in% 1:4, (4 - A12A) / 3, NA),
a12b_01 = ifelse(A12B %in% 1:4, (4 - A12B) / 3, NA),
a13a_01 = ifelse(A13A %in% 1:4, (4 - A13A) / 3, NA),
a13b_01 = ifelse(A13B %in% 1:4, (4 - A13B) / 3, NA),
a13c_01 = ifelse(A13C %in% 1:4, (4 - A13C) / 3, NA)
)
design_w$variables$experience_01 <- rowMeans(
design_w$variables[, c("a12a_01", "a12b_01", "a13a_01", "a13b_01", "a13c_01")]
)
design_w$variables$admin_particularism <- rowMeans(
design_w$variables[, c("e2_audit_01", "e2_bias_01", "experience_01")]
)
svymean(~e2_audit_01 + e2_bias_01 + experience_01 + admin_particularism,
design = design_w, na.rm = TRUE)
svyquantile(
~admin_particularism,
design_w,
quantiles = c(0, 0.25, 0.5, 0.75, 1),
na.rm = TRUE
)
vars_e2 <- na.omit(design_w$variables[, c(
"e2_audit_01",
"e2_bias_01",
"experience_01"
)])
fa_e2 <- factanal(vars_e2, factors = 1, scores = "regression")
fa_e2
design_w <- update(
design_w,
j_impunity_01 = ifelse(J5_CON_C %in% 1:4, (4 - J5_CON_C) / 3, NA),
a4o_01 = ifelse(A4O %in% 1:4, (4 - A4O) / 3, NA),
a4s_01 = ifelse(A4S %in% 1:4, (4 - A4S) / 3, NA)
)
# Elite corruption perception
design_w$variables$a4_elite_01 <- rowMeans(
design_w$variables[, c("a4o_01", "a4s_01")]
)
# Final index
design_w$variables$impunity_track <- rowMeans(
design_w$variables[, c("j_impunity_01", "a4_elite_01")]
)
# Diagnostics
svymean(~j_impunity_01 + a4_elite_01 + impunity_track,
design = design_w, na.rm = TRUE)
vars_e3 <- na.omit(design_w$variables[, c(
"j_impunity_01",
"a4_elite_01"
)])
cor(vars_e3)
design_w <- update(
design_w,
# mechanism
j1_control_01 = ifelse(J5_CON_A %in% 1:4, (4 - J5_CON_A)/3, NA),
# outcomes
a4g_01 = ifelse(A4G %in% 1:4, (4 - A4G)/3, NA),
a4h_01 = ifelse(A4H %in% 1:4, (4 - A4H)/3, NA),
a4i_01 = ifelse(A4I %in% 1:4, (4 - A4I)/3, NA)
)
design_w$variables$j1_outcome <- rowMeans(
design_w$variables[, c("a4g_01", "a4h_01", "a4i_01")]
)
design_w$variables$appointment_capture <- rowMeans(
design_w$variables[, c( "j1_control_01", "j1_outcome")]
)
# Select ONLY raw components (no constructed index)
vars_to_factor <- design_w$variables[, c(
"j1_control_01",
"a4g_01",
"a4h_01",
"a4i_01"
)]
vars_clean <- vars_to_factor[complete.cases(vars_to_factor), ]
fa_j1 <- factanal(vars_clean, factors = 1, scores = "regression")
fa_j1
design_w <- update(
design_w,
resilience = ifelse(J6_RES %in% 1:4, (J6_RES - 1) / 3, NA),
d51_g = ifelse(D51G %in% 1:4, (D51G - 1) / 3, NA),
d51_h = ifelse(D51H %in% 1:4, (D51H - 1) / 3, NA)
)
design_w$variables$d_gh <- rowMeans(
design_w$variables[, c("d51_g", "d51_h")]
)
design_w$variables$func_sub <- rowMeans(
design_w$variables[, c("d_gh", "resilience")]
)
svymean(~resilience+d51_g+d51_h, design = design_w, na.rm = TRUE)
var_4<-na.omit(design_w$variables[, c("d51_g","d51_h","resilience","d_gh")])
dim(var_4)
fact_anal1<-factanal(var_4[-4], factors=1, scores="regression")
fact_anal1
design_w <- update(
design_w,
j_control = ifelse(J5_CON_B %in% 1:4, (4-J5_CON_B) / 3, NA),
j_4= ifelse(J4 %in% 1:4, (4-J4) / 3, NA)
)
design_w$variables$case_rigging <- rowMeans(
design_w$variables[, c("j_control", "j_4")]
)
svymean(~j_control+j_4+case_rigging, design = design_w, na.rm=TRUE)
var_check<-na.omit(design_w$variables[, c("j_control","j_4")])
cor(var_check)
design_w <- update(
design_w,
# SC1 (actors)
sc1a_01 = ifelse(SC1A %in% 1:4, (4 - SC1A)/3, NA),
sc1b_01 = ifelse(SC1B %in% 1:4, (4 - SC1B)/3, NA),
sc1c_01 = ifelse(SC1C %in% 1:4, (4 - SC1C)/3, NA),
sc1d_01 = ifelse(SC1D %in% 1:4, (4 - SC1D)/3, NA),
# SC2 (mechanisms)
sc2a_01 = ifelse(SC2A %in% 1:4, (4 - SC2A)/3, NA),
sc2b_01 = ifelse(SC2B %in% 1:4, (4 - SC2B)/3, NA),
sc2c_01 = ifelse(SC2C %in% 1:4, (4 - SC2C)/3, NA),
sc2d_01 = ifelse(SC2D %in% 1:4, (4 - SC2D)/3, NA),
sc2e_01 = ifelse(SC2E %in% 1:4, (4 - SC2E)/3, NA),
sc2f_01 = ifelse(SC2F %in% 1:4, (4 - SC2F)/3, NA),
# SC6 (likelihood)
sc6_01 = ifelse(SC6 %in% 1:4, (4 - SC6)/3, NA)
)
design_w$variables$foreign_actors <- rowMeans(
design_w$variables[, c("sc1a_01", "sc1b_01", "sc1c_01", "sc1d_01")]
)
design_w$variables$foreign_mechanisms <- rowMeans(
design_w$variables[, c("sc2a_01", "sc2b_01", "sc2c_01", "sc2d_01", "sc2e_01", "sc2f_01")]
)
design_w$variables$foreign_capture <- rowMeans(
design_w$variables[, c("foreign_actors", "foreign_mechanisms", "sc6_01")]
)
table(!is.na(design_w$variables$foreign_actors))
table(!is.na(design_w$variables$foreign_mechanisms))
table(!is.na(design_w$variables$foreign_capture))
svymean(~foreign_actors + foreign_mechanisms + foreign_capture, design = design_w, na.rm = TRUE)
vars_foreign <- na.omit(
design_w$variables[, c(
"sc1a_01", "sc1b_01", "sc1c_01", "sc1d_01",
"sc2a_01", "sc2b_01", "sc2c_01", "sc2d_01", "sc2e_01", "sc2f_01",
"sc6_01"
)]
)
dim(vars_foreign)
fa_foreign_1 <- factanal(vars_foreign, factors = 5, scores = "regression", control="rotate")
print(fa_foreign_1, cutoff=0.5)
var_5<-na.omit(design_w$variables[, c("foreign_actors","foreign_mechanisms", "foreign_capture")])
factanal(var_5, factor=1, score="regression")
vars_foreign <- na.omit(
design_w$variables[, c(
"sc1a_01", "sc1b_01", "sc1c_01", "sc1d_01",
"sc2a_01", "sc2b_01", "sc2c_01", "sc2d_01", "sc2e_01", "sc2f_01",
"sc6_01"
)]
)
dim(vars_foreign)
fa_foreign_1 <- factanal(vars_foreign, factors = 5, scores = "regression", control="rotate")
print(fa_foreign_1, cutoff=0.0)
var_5<-na.omit(design_w$variables[, c("foreign_actors","foreign_mechanisms", "foreign_capture")])
factanal(var_5, factor=1, score="regression")
library(haven)
library(survey)
CMS_DATA_BG <- haven::read_sav("CMS_logical_corrections_V1.sav", user_na = TRUE)
library(haven)
library(survey)
CMS_DATA_BG <- haven::read_sav("CMS_RALITS_CORRECTION.sav", user_na = TRUE)
head(CMS_DATA_BG)
library(dplyr)
CMS_DATA_BG <- CMS_DATA_BG %>%
mutate(
# keep existing Changed_dummy entries; treat NA as 0 only for this update step
Changed_dummy = if_else(is.na(Changed_dummy), 0, Changed_dummy),
missing_key = if_else(
is.na(D2) | D2 >= 99 |                  # Age
is.na(D1) | !(D1 %in% c(1, 2)) |        # Sex
is.na(D26) | !(D26 %in% c(1, 2, 3, 4)), # Settlement
1, 0
),
# preserve prior 1s, add new 1s where key covariates are bad
Changed_dummy = if_else(Changed_dummy == 1 | missing_key == 1, 1, 0)
)
library(dplyr)
CMS_DATA_BG <- CMS_DATA_BG %>%
mutate(
missing_key = if_else(
is.na(D2) | D2 >= 99 |                  # Age
is.na(D1) | !(D1 %in% c(1, 2)) |        # Sex
is.na(D26) | !(D26 %in% c(1, 2, 3, 4)), # Settlement
1, 0
),
)
df_clean <- CMS_DATA_BG %>%
mutate(
age_group = case_when(
D2 >= 18 & D2 <= 24 ~ "18-24",
D2 <= 34 ~ "25-34",
D2 <= 44 ~ "35-44",
D2 <= 54 ~ "45-54",
D2 <= 64 ~ "55-64",
D2 >= 65 ~ "65+"
),
sex = factor(D1, levels = c(1, 2), labels = c("Male", "Female"))
)
# Share dropped
table(df_clean$Changed_dummy)
# Distributions
table(df_clean$age_group)
table(df_clean$sex)
# Distributions
table(df_clean$age_group)
table(df_clean$sex)
library(eurostat)
library(dplyr)
library(lubridate)
pop_raw <- get_eurostat("demo_pjan", time_format = "num")
bg_pop <- pop_raw %>%
filter(
geo == "BG",
TIME_PERIOD== 2025,              # survey year
sex %in% c("M", "F"),
age %in% c(paste0("Y", 18:99), "Y_GE90")
)
bg_pop_age_sex <- bg_pop %>%
mutate(
age_num = case_when(
age == "Y_GE90" ~ 90,
TRUE ~ as.numeric(sub("^Y", "", age))
),
sex = recode(sex,
"M" = "Male",
"F" = "Female"
),
age_group = case_when(
age_num >= 18 & age_num <= 24 ~ "18-24",
age_num >= 25 & age_num <= 34 ~ "25-34",
age_num >= 35 & age_num <= 44 ~ "35-44",
age_num >= 45 & age_num <= 54 ~ "45-54",
age_num >= 55 & age_num <= 64 ~ "55-64",
age_num >= 65               ~ "65+"
)
) %>%
filter(!is.na(age_group)) %>%
group_by(age_group, sex) %>%
summarise(pop = sum(values, na.rm = TRUE), .groups = "drop") %>%
mutate(Freq = pop / sum(pop))
bg_pop_age_sex
pop_sex <- bg_pop_age_sex %>%
group_by(sex) %>%
summarise(pop = sum(pop), .groups = "drop") %>%
mutate(Freq = pop / sum(pop))
pop_sex
sum(bg_pop_age_sex$Freq)
sample_age_sex <- df_clean %>%
group_by(age_group, sex) %>%
summarise(n_sample = n(), .groups = "drop")
weight_table <- sample_age_sex %>%
merge(bg_pop_age_sex, by = c("age_group", "sex"), all.x = TRUE)
weight_table <- weight_table %>%
mutate(
sample_share = n_sample / sum(n_sample),
pop_share    = Freq / sum(Freq),
weight       = pop_share / sample_share
)
df_clean <- merge(
df_clean,
weight_table[, c("age_group", "sex", "weight")],
by = c("age_group", "sex"),
all.x = TRUE
)
# Check key uniqueness in weight table
any(duplicated(weight_table[, c("age_group", "sex")]))
# Check missing weights
table(is.na(df_clean$weight))
# Check weight distribution
summary(df_clean$weight)
# Check one weight per cell
aggregate(weight ~ age_group + sex, data = df_clean, function(x) length(unique(x)))
# Compare weighted sample shares to population shares
weighted_shares <- xtabs(weight ~ age_group + sex, data = df_clean)
weighted_shares <- weighted_shares / sum(weighted_shares)
pop_shares <- xtabs(Freq ~ age_group + sex, data = bg_pop_age_sex)
pop_shares <- pop_shares / sum(pop_shares)
weighted_shares
pop_shares
# Mean weight
mean(df_clean$weight, na.rm = TRUE)
set.seed(123)
df_clean[sample(nrow(df_clean), 10),
c("age_group", "sex", "weight")]
View(weight_table)
View(CMS_DATA_BG)
write_sav(CMS_DATA_BG,"CMS_BG_RALITSA_WEIGHTED.sav")
write_sav(df_clean,"CMS_BG_RALITSA_WEIGHTED.sav")
